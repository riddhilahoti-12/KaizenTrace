# ==============================================================================
# KaizenTrace Integrated Workspace Environment Configuration
# ==============================================================================

# --- KaizenTrace Tool Suite (Backend: Port 5050, Frontend: Port 5174) ---
KAIZENTRACE_PORT=5050
KAIZENTRACE_MONGODB_URI=memory
# For persistent MongoDB Atlas, set your Atlas connection string:
# KAIZENTRACE_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/kaizentrace?retryWrites=true&w=majority

# Target application integration
TEAMFLOW_API_URL=http://localhost:5000

# --- TeamFlow Demo Application (Backend: Port 5000, Frontend: Port 5173) ---
PORT=5000
NODE_ENV=development
MONGODB_URI=memory
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/teamflow?retryWrites=true&w=majority
CORS_ORIGIN=http://localhost:5173
KAIZENTRACE_URL=http://localhost:5050
LOG_LEVEL=info

# Background job configuration
ENABLE_DEADLINE_JOB=true
DEADLINE_JOB_INTERVAL_MS=60000

# Demo fault injection flags (Disabled by default)
TEST_FAIL_DEADLINE_JOB=false
TEST_FAIL_TASK_UPDATE=false
TEST_DISABLE_PERMISSIONS=false
